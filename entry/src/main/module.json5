{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [
      {
        "name": "client_id",
        "value": "1532776613270319808"
      },
      {
        "name": "app_id",
        "value": "6917614352726343880"
      },
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      },
      {
        // 官方安全区规范：将摄像头挖孔区视为避让区，页面默认避让挖孔，
        // 防止特殊挖孔设备上状态栏时间/电量图标与标题栏内容重叠（API 12+）
        "name": "avoid_cutout",
        "value": "true"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:permission_internet_reason"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:permission_network_reason"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/abilities/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:foreground",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.security.NETWORK_SECURITY_CONFIG",
            "resource": "$profile:network_security_config"
          },
          {
            "name": "client_id",
            "value": "1532776613270319808"
          },
          {
            "name": "app_id",
            "value": "6917614352726343880"
          }
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/abilities/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}
